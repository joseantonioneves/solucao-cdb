{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build",
        "command": "dotnet",
        "type": "process",
        "args": [
          "build",
          "${workspaceFolder}/solucao-cdb.sln",
          "--configuration",
          "Debug"
        ],
        "problemMatcher": "$msCompile"
      },
      {
        "label": "test",
        "command": "dotnet",
        "type": "process",
        "args": [
          "test",
          "${workspaceFolder}/tests/Application.Tests/Application.Tests.csproj",
          "--no-build"
        ],
        "problemMatcher": "$msCompile"
      }
    ]
  }
  